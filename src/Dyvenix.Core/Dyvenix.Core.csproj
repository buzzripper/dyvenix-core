<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Dyvenix.Core</AssemblyName>
		<RootNamespace>Dyvenix.Core</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Dyvenix.Core</PackageId>
		<!-- Version is supplied by the CI workflow from the Git tag (e.g. -p:Version=1.2.0).
			 This default is only used for local/dev builds without a tag. -->
		<Version>0.0.0-dev</Version>
		<!-- Pinned to major-only for stable binding identity; bump manually on a major release. -->
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<Authors>buzzripper</Authors>
		<Description>Dyvenix.Core shared library.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/buzzripper/dyvenix-core</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
	</ItemGroup>

</Project>
